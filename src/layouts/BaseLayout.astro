---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE } from '../config';

interface Props {
  /** Título de la página (sin el nombre de la marca). Omitir en la portada. */
  title?: string;
  description: string;
  noindex?: boolean;
}

const { title, description, noindex = false } = Astro.props;

const pageTitle = title ? `${title} · ${SITE.name}` : `${SITE.name} · ${SITE.slogan}`;
const pathname = Astro.url.pathname.replace(/(index)?\.html$/, '').replace(/\/+$/, '') || '/';
const canonical = new URL(pathname, SITE.url).href;
const ogImage = new URL('/og-image.jpg', SITE.url).href;

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': `${SITE.url}/#organization`,
      name: SITE.name,
      alternateName: SITE.shortName,
      slogan: SITE.slogan,
      legalName: SITE.legal.owner,
      taxID: SITE.legal.taxId,
      url: `${SITE.url}/`,
      logo: `${SITE.url}/logo-512.png`,
      email: SITE.email,
      telephone: SITE.phone,
      address: {
        '@type': 'PostalAddress',
        streetAddress: SITE.legal.address,
        postalCode: SITE.legal.postalCode,
        addressLocality: SITE.legal.city,
        addressCountry: 'ES',
      },
      founder: { '@type': 'Person', name: SITE.founder.fullName, jobTitle: SITE.founder.role },
    },
    {
      '@type': 'WebSite',
      '@id': `${SITE.url}/#website`,
      url: `${SITE.url}/`,
      name: SITE.name,
      inLanguage: 'es',
      publisher: { '@id': `${SITE.url}/#organization` },
    },
    {
      '@type': 'WebPage',
      '@id': `${canonical}#webpage`,
      url: canonical,
      name: pageTitle,
      description,
      inLanguage: 'es',
      isPartOf: { '@id': `${SITE.url}/#website` },
    },
  ],
};
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta name="theme-color" content="#0b0b0b" />
    <meta name="color-scheme" content="light" />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <link rel="preload" href="/fonts/nuFiD-vYSZviVYUb_rj3ij__anPXDTzYgA.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/S6uyw4BMUTPHjx4wXg.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/JTUSjIg1_i6t8kCHKm459Wlhyw.woff2" as="font" type="font/woff2" crossorigin />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content={SITE.locale} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Hot Host Hospitality — Hospitalidad con personalidad" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <script is:inline>document.documentElement.classList.add('js');</script>
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <a href="#contenido" class="skip-link">Saltar al contenido</a>
    <Header />
    <main id="contenido" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <script>
      import '../scripts/site';
    </script>
  </body>
</html>

<style is:global>
  .skip-link {
    position: fixed;
    top: 0.75rem;
    left: 0.75rem;
    z-index: 100;
    padding: 0.75rem 1.1rem;
    border-radius: 999px;
    background: var(--color-gold);
    color: var(--color-ink);
    font-family: var(--font-ui);
    font-size: 0.875rem;
    font-weight: 700;
    transform: translateY(-160%);
    transition: transform 0.2s ease;
  }
  .skip-link:focus { transform: none; }
  main:focus { outline: none; }
</style>
