---
import { ANALYZE_HREF } from '../data/navigation';

interface Props {
  title?: string;
  text?: string;
  buttonLabel?: string;
  href?: string;
}

// Por defecto, el CTA final de Inicio (03-copy-web.md).
const {
  title = '¿Hablamos de tu propiedad?',
  text = 'Analízala gratis.',
  buttonLabel = 'Analizar mi propiedad',
  href = ANALYZE_HREF,
} = Astro.props;
---

<section class="on-dark cta-ember relative overflow-hidden">
  <div class="container-x relative py-20 text-center lg:py-28">
    <svg class="mx-auto h-10 w-28 text-gold" viewBox="0 0 120 40" fill="none" aria-hidden="true">
      <path d="M8 36 60 5l52 31" stroke="currentColor" stroke-width="2.4" stroke-linecap="square" />
      <rect x="55" y="17" width="4" height="4" fill="currentColor" />
      <rect x="61" y="17" width="4" height="4" fill="currentColor" />
      <rect x="55" y="23" width="4" height="4" fill="currentColor" />
      <rect x="61" y="23" width="4" height="4" fill="currentColor" />
    </svg>
    <h2 class="h-section mx-auto mt-6 max-w-3xl text-snow">{title}</h2>
    {text && <p class="quote mx-auto mt-4 max-w-2xl text-gold">{text}</p>}
    <div class="mt-10 flex flex-wrap justify-center gap-4">
      <a href={href} class="btn btn-primary">
        {buttonLabel} <span aria-hidden="true">→</span>
      </a>
      <slot />
    </div>
  </div>
</section>

<style>
  .cta-ember {
    background:
      radial-gradient(60% 90% at 50% 120%, rgb(226 88 34 / 0.38), transparent 70%),
      radial-gradient(30% 50% at 50% -20%, rgb(192 159 36 / 0.12), transparent 70%),
      var(--color-ink);
  }
</style>
