---
interface Crumb {
  label: string;
  href?: string;
}

interface Props {
  eyebrow?: string;
  title?: string;
  lead?: string;
  crumbs?: Crumb[];
}

const { eyebrow, title, lead, crumbs = [] } = Astro.props;
const trail: Crumb[] = crumbs.length ? [{ label: 'Inicio', href: '/' }, ...crumbs] : [];
---

<section class="on-dark bg-ember relative overflow-hidden">
  <div class="container-x relative pt-14 pb-16 lg:pt-20 lg:pb-24">
    {
      trail.length > 0 && (
        <nav aria-label="Migas de pan" class="mb-10">
          <ol class="flex flex-wrap items-center gap-x-2 gap-y-1 font-ui text-xs font-medium tracking-wide text-dim">
            {trail.map((crumb, index) => (
              <li class="flex items-center gap-2">
                {index > 0 && <span aria-hidden="true" class="text-gold/60">/</span>}
                {crumb.href && index < trail.length - 1 ? (
                  <a href={crumb.href} class="transition-colors hover:text-gold">{crumb.label}</a>
                ) : (
                  <span aria-current="page" class="text-snow/90">{crumb.label}</span>
                )}
              </li>
            ))}
          </ol>
        </nav>
      )
    }
    <div class="max-w-4xl">
      {eyebrow && <p class="eyebrow">{eyebrow}</p>}
      <h1 class="h-page mt-5 text-snow">
        {Astro.slots.has('title') ? <slot name="title" /> : title}
      </h1>
      {lead && <p class="lead mt-6 max-w-3xl">{lead}</p>}
      <slot />
    </div>
  </div>
  <div class="container-x" aria-hidden="true">
    <div class="rule-diamond opacity-60"><span></span></div>
  </div>
</section>
