---
import { MAIN_NAV, PILLARS, LEGAL_NAV } from '../data/navigation';
import { SITE } from '../config';

const year = new Date().getFullYear();
const companyLinks = MAIN_NAV.filter((item) => item.href !== '/pilares');
---

<footer class="on-dark border-t border-gold/20">
  <div class="container-x pt-16 pb-10 lg:pt-20">
    <div class="grid gap-12 lg:grid-cols-[1.4fr_1fr_1fr_1fr]">
      <div class="max-w-sm">
        <a href="/" class="inline-flex items-center gap-3" aria-label={`${SITE.name} — Inicio`}>
          <img src="/logo-mark.svg" width="56" height="56" alt="" class="size-14" loading="lazy" />
          <span class="grid leading-none" aria-hidden="true">
            <span class="font-ui text-base font-bold tracking-[0.22em] text-snow uppercase">Hot Host</span>
            <span class="mt-1.5 font-ui text-[0.62rem] font-semibold tracking-[0.44em] text-gold uppercase">Hospitality</span>
          </span>
        </a>
        <p class="quote mt-6 text-[1.6rem] text-snow">{SITE.slogan}.</p>
        <a href={`mailto:${SITE.email}`} class="link-arrow mt-6">{SITE.email}</a>
      </div>

      <nav aria-labelledby="footer-pilares">
        <h2 id="footer-pilares" class="footer-heading">Pilares</h2>
        <ul class="footer-list">
          {PILLARS.map((pillar) => <li><a href={pillar.href}>{pillar.label}</a></li>)}
          <li><a href="/pilares">Los 3 pilares</a></li>
        </ul>
      </nav>

      <nav aria-labelledby="footer-empresa">
        <h2 id="footer-empresa" class="footer-heading">Hot Host</h2>
        <ul class="footer-list">
          <li><a href="/">Inicio</a></li>
          {companyLinks.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
        </ul>
      </nav>

      <nav aria-labelledby="footer-legal">
        <h2 id="footer-legal" class="footer-heading">Legal</h2>
        <ul class="footer-list">
          {LEGAL_NAV.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
        </ul>
      </nav>
    </div>

    <div class="rule-diamond mt-14" aria-hidden="true"><span></span></div>

    <div class="mt-8 flex flex-col gap-2 text-sm text-dim sm:flex-row sm:items-center sm:justify-between">
      <p>© {year} {SITE.name}. Todos los derechos reservados.</p>
      <p>{SITE.legal.owner} · {SITE.legal.city}</p>
    </div>
  </div>
</footer>

<style>
  .footer-heading {
    font-family: var(--font-ui);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-gold);
  }
  .footer-list {
    display: grid;
    gap: 0.65rem;
    margin-top: 1.25rem;
    font-size: 0.9375rem;
  }
  .footer-list a {
    color: rgb(245 240 230 / 0.8);
    transition: color 0.2s ease;
  }
  .footer-list a:hover { color: var(--color-gold); }
</style>
