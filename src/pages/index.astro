---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import PillarHouse from '../components/PillarHouse.astro';
import SectionHeading from '../components/SectionHeading.astro';
import CtaBanner from '../components/CtaBanner.astro';
import { PILLARS, ANALYZE_HREF } from '../data/navigation';
import { STEPS } from '../data/content';
import { SITE } from '../config';
import founderPhoto from '../assets/yunior-bacallao-fundador.png';

const diyPains = [
  'Coordinar limpiezas',
  'Responder mensajes a cualquier hora',
  'Ajustar precios a ojo',
  'Competir en un mercado donde todo el mundo se parece',
];
const managerPains = ['Comunicación fría', 'Cero personalidad', 'La sensación de que tu propiedad es una más de cien'];
---

<BaseLayout description="Gestión de alquiler vacacional con estándares hoteleros, canal de reserva propio y experiencias que hacen que los huéspedes vuelvan — sin perder el trato humano.">
  <!-- Portada -->
  <section class="on-dark bg-ember relative overflow-hidden">
    <div class="container-x grid items-center gap-14 pt-16 pb-20 lg:grid-cols-[1.15fr_0.85fr] lg:gap-16 lg:pt-24 lg:pb-28">
      <div>
        <p class="eyebrow">{SITE.slogan}</p>
        <h1 class="h-display mt-6 text-snow">
          Tu propiedad tiene <span class="accent">más potencial</span> del que le estás pidiendo.
        </h1>
        <p class="lead mt-7 max-w-2xl">
          Gestión con estándares hoteleros, canal de reserva propio y experiencias que hacen que los huéspedes vuelvan — sin perder el trato humano por el camino.
        </p>
        <div class="mt-10 flex flex-wrap gap-4">
          <a href={ANALYZE_HREF} class="btn btn-primary">Analizar mi propiedad <span aria-hidden="true">→</span></a>
          <a href="/pilares" class="btn btn-ghost">Ver los 3 pilares</a>
        </div>
      </div>
      <PillarHouse class="mx-auto w-full max-w-md lg:max-w-none" />
    </div>
    <div class="container-x" aria-hidden="true">
      <div class="rule-diamond opacity-60"><span></span></div>
    </div>
  </section>

  <!-- El problema -->
  <section class="section" aria-labelledby="problema">
    <div class="container-x">
      <h2 id="problema" class="eyebrow">El problema</h2>
      <div class="mt-8 grid gap-6 lg:grid-cols-2 lg:gap-8">
        <article class="card reveal p-8 lg:p-10">
          <p class="font-display text-[1.45rem] leading-snug font-semibold">
            Si gestionas tu alojamiento por tu cuenta, probablemente ya conoces esto:
          </p>
          <ul class="pain-list mt-6">
            {diyPains.map((pain) => <li>{pain}</li>)}
          </ul>
        </article>
        <article class="card reveal bg-sand p-8 lg:p-10" style="--reveal-delay: 120ms">
          <p class="font-display text-[1.45rem] leading-snug font-semibold">
            Si ya tienes un gestor, puede que hayas cambiado un problema por otro:
          </p>
          <ul class="pain-list mt-6">
            {managerPains.map((pain) => <li>{pain}</li>)}
          </ul>
        </article>
      </div>
    </div>
  </section>

  <!-- La solución -->
  <section class="section bg-paper" aria-labelledby="solucion">
    <div class="container-x">
      <SectionHeading eyebrow="La solución Hot Host" id="solucion">
        <Fragment slot="title">Hot Host se construye sobre <span class="accent">tres pilares.</span></Fragment>
      </SectionHeading>
      <ol class="mt-12 grid gap-6 md:grid-cols-3">
        {
          PILLARS.map((pillar, index) => (
            <li class="reveal" style={`--reveal-delay: ${index * 110}ms`}>
              <a href={pillar.href} class="pillar-card group">
                <span class="num text-4xl">{pillar.number}</span>
                <h3 class="h-card mt-6">{pillar.label}</h3>
                <p class="mt-3 text-muted">{pillar.summary}</p>
                <span class="link-arrow mt-auto pt-8">
                  Conocer el pilar <span aria-hidden="true">→</span>
                </span>
              </a>
            </li>
          ))
        }
      </ol>
      <p class="mt-10">
        <a href="/pilares" class="link-arrow">Ver los 3 pilares <span aria-hidden="true">→</span></a>
      </p>
    </div>
  </section>

  <!-- Cómo funciona (resumen) -->
  <section class="section" aria-labelledby="como-funciona">
    <div class="container-x">
      <SectionHeading
        eyebrow="Cómo funciona"
        id="como-funciona"
        title="De la primera conversación a tener tu propiedad gestionada."
      />
      <ol class="steps-row mt-14">
        {
          STEPS.map((step, index) => (
            <li class="reveal" style={`--reveal-delay: ${index * 90}ms`}>
              <span class="num text-3xl">{String(index + 1).padStart(2, '0')}</span>
              <span class="step-dot" aria-hidden="true"></span>
              <h3 class="mt-4 font-display text-lg leading-snug font-bold">{step.title}</h3>
            </li>
          ))
        }
      </ol>
      <p class="mt-12">
        <a href="/como-funciona" class="link-arrow">Ver los 5 pasos en detalle <span aria-hidden="true">→</span></a>
      </p>
    </div>
  </section>

  <!-- Fundador -->
  <section class="section bg-sand" aria-labelledby="fundador">
    <div class="container-x">
      <div class="founder-strip card reveal grid overflow-hidden md:grid-cols-[minmax(0,0.8fr)_minmax(0,1.2fr)]">
        <Image
          src={founderPhoto}
          alt="Yunior Bacallao, fundador de Hot Host Hospitality"
          widths={[360, 540, 720]}
          sizes="(min-width: 768px) 40vw, 100vw"
          class="h-full max-h-[26rem] w-full object-cover object-top md:max-h-none"
        />
        <div class="flex flex-col justify-center p-8 lg:p-14">
          <p class="eyebrow">Sobre Hot Host</p>
          <h2 id="fundador" class="h-section mt-4">13 años viendo qué hace que un huésped vuelva.</h2>
          <p class="mt-5 text-muted">
            Trayectoria personal de {SITE.founder.name}, fundador, en hoteles y en hostelería — antes de que existiera Hot Host.
          </p>
          <p class="mt-8">
            <a href="/sobre-hot-host" class="link-arrow">Conocer la historia <span aria-hidden="true">→</span></a>
          </p>
        </div>
      </div>
    </div>
  </section>

  <CtaBanner />
</BaseLayout>

<style>
  .pain-list {
    display: grid;
    gap: 0.9rem;
  }
  .pain-list li {
    position: relative;
    padding-left: 1.6rem;
    color: var(--color-muted);
  }
  .pain-list li::before {
    content: '';
    position: absolute;
    top: 0.8em;
    left: 0;
    width: 0.9rem;
    height: 1px;
    background-color: var(--color-fire-deep);
  }

  .pillar-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: 2rem;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-card);
    background-color: var(--color-cream);
    transition: border-color 0.25s ease, box-shadow 0.25s ease, transform 0.25s ease;
  }
  .pillar-card:hover {
    border-color: var(--color-gold);
    box-shadow: var(--shadow-lift);
    transform: translateY(-3px);
  }

  .steps-row {
    display: grid;
    gap: 2rem;
    counter-reset: step;
  }
  .steps-row li {
    position: relative;
    display: grid;
    justify-items: start;
  }
  .step-dot {
    display: block;
    width: 100%;
    height: 1px;
    margin-top: 1rem;
    background: linear-gradient(to right, var(--color-gold), rgb(192 159 36 / 0.15));
    position: relative;
  }
  .step-dot::before {
    content: '';
    position: absolute;
    top: -4px;
    left: 0;
    width: 9px;
    height: 9px;
    background-color: var(--color-fire-deep);
    transform: rotate(45deg);
  }
  @media (min-width: 768px) {
    .steps-row { grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 1.5rem; }
  }
</style>
