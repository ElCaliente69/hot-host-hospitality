---
/**
 * Puente de los enlaces privados que envía el Apps Script por email:
 *   https://hhosthospitality.com/solicitud.html#request=TOKEN  (visitante: verificar / estado)
 *   https://hhosthospitality.com/solicitud.html#admin=TOKEN    (Yunior: revisar la solicitud)
 * Lógica idéntica a la solicitud.html de la web anterior: valida el token del #hash y
 * redirige al Web App. NO renombrar ni mover esta página: los emails ya enviados apuntan aquí.
 */
import { APPS_SCRIPT_ENDPOINT, SITE } from '../config';
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta name="robots" content="noindex,nofollow" />
    <meta name="referrer" content="no-referrer" />
    <meta
      http-equiv="Content-Security-Policy"
      content="default-src 'none'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self'; base-uri 'none'; form-action 'none'; object-src 'none'"
    />
    <title>Solicitud segura · Hot Host Hospitality</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <style is:inline>
      @font-face { font-family: 'Playfair Display'; font-weight: 600 800; font-display: swap; src: url(/fonts/nuFiD-vYSZviVYUb_rj3ij__anPXDTzYgA.woff2) format('woff2'); }
      @font-face { font-family: 'Lato'; font-weight: 400; font-display: swap; src: url(/fonts/S6uyw4BMUTPHjx4wXg.woff2) format('woff2'); }
      :root { color-scheme: light; }
      * { box-sizing: border-box; }
      body { margin: 0; min-height: 100vh; display: grid; place-items: center; padding: 18px; background: radial-gradient(circle at 50% 120%, rgba(226, 88, 34, .22), transparent 60%), #0b0b0b; color: #0b0b0b; font-family: Lato, Arial, sans-serif; }
      main { width: min(560px, 100%); overflow: hidden; border: 1px solid rgba(192, 159, 36, .45); border-radius: 22px; background: #fbf7ee; box-shadow: 0 30px 70px rgba(0, 0, 0, .45); }
      .brand { display: flex; align-items: center; gap: 14px; padding: 22px 30px; background: #0b0b0b; color: #f5f0e6; }
      .brand img { width: 44px; height: 44px; }
      .brand strong { display: block; font: 700 16px/1 Arial, sans-serif; letter-spacing: .22em; }
      .brand span { display: block; margin-top: 6px; color: #c09f24; font: 700 10px/1 Arial, sans-serif; letter-spacing: .42em; }
      .content { padding: 32px 30px 36px; }
      .label { display: inline-block; padding: 7px 13px; border-radius: 999px; background: #faf3dd; color: #7d6716; font: 700 12px/1 Arial, sans-serif; letter-spacing: .08em; text-transform: uppercase; }
      h1 { margin: 18px 0 12px; font: 700 clamp(28px, 7vw, 42px)/1.08 'Playfair Display', Georgia, serif; }
      p { margin: 0; color: #5e5647; font-size: 16px; line-height: 1.65; }
      a { display: inline-block; margin-top: 24px; padding: 13px 22px; border-radius: 999px; background: #c2461a; color: #fff; font: 700 15px/1 Arial, sans-serif; text-decoration: none; }
      a:hover { background: #a63a14; }
      [hidden] { display: none; }
    </style>
  </head>
  <body>
    <main>
      <div class="brand">
        <img src="/logo-mark.svg" alt="" width="44" height="44" />
        <div><strong>HOT HOST</strong><span>HOSPITALITY</span></div>
      </div>
      <div class="content">
        <span class="label">Enlace privado</span>
        <h1 id="title">Abriendo tu solicitud</h1>
        <p id="message">Estamos conectando de forma segura con el estado de tu solicitud.</p>
        <a id="continue" href="#" rel="noreferrer" hidden>Continuar</a>
      </div>
    </main>
    <script is:inline define:vars={{ endpointValue: APPS_SCRIPT_ENDPOINT, contactEmail: SITE.email }}>
      (function () {
        'use strict';
        var title = document.getElementById('title');
        var message = document.getElementById('message');
        var continueLink = document.getElementById('continue');
        var parameters = new URLSearchParams(window.location.hash.slice(1));
        var type = parameters.has('request') ? 'request' : parameters.has('admin') ? 'admin' : '';
        var token = type ? String(parameters.get(type) || '').trim() : '';
        var endpoint = String(endpointValue || '').trim();

        if (!type || !/^[a-f0-9]{64}$/i.test(token) || !/^https:\/\/script\.google\.com\/macros\/s\/[^/]+\/exec$/.test(endpoint)) {
          title.textContent = 'Enlace no válido';
          message.textContent = 'Abre el enlace incluido en el último correo de Hot Host Hospitality o escribe a ' + contactEmail + '.';
          return;
        }

        var target = new URL(endpoint);
        target.searchParams.set(type, token);
        continueLink.href = target.toString();
        continueLink.hidden = false;
        window.location.replace(target.toString());
      })();
    </script>
  </body>
</html>
