---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import CtaBanner from '../components/CtaBanner.astro';
import { STEPS } from '../data/content';
import { ANALYZE_HREF } from '../data/navigation';
---

<BaseLayout
  title="Cómo funciona"
  description="De la primera conversación a tener tu propiedad gestionada, en cinco pasos: formulario, auditoría y propuesta, puesta a punto, gestión activa y revisión continua."
>
  <PageHero eyebrow="Cómo funciona" crumbs={[{ label: 'Cómo funciona' }]}>
    <Fragment slot="title">De la primera conversación a tener tu <span class="accent">propiedad gestionada.</span></Fragment>
  </PageHero>

  <section class="section" aria-label="Los cinco pasos">
    <div class="container-x">
      <ol class="timeline mx-auto max-w-4xl">
        {
          STEPS.map((step, index) => (
            <li class="timeline-step reveal">
              <span class="timeline-num num" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
              <div class="card p-7 sm:p-9">
                <p class="font-ui text-xs font-semibold tracking-[0.2em] text-fire-deep uppercase">Paso {index + 1}</p>
                <h2 class="mt-3 font-display text-[clamp(1.4rem,1.2rem+0.8vw,1.85rem)] leading-tight font-bold">{step.title}</h2>
                <p class="mt-3 text-lg text-muted">{step.text}</p>
                {index === 0 && (
                  <a href={ANALYZE_HREF} class="link-arrow mt-6">
                    Empezar ahora <span aria-hidden="true">→</span>
                  </a>
                )}
                {index === 1 && (
                  <a href="/precios" class="link-arrow mt-6">
                    Ver los niveles <span aria-hidden="true">→</span>
                  </a>
                )}
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <CtaBanner />
</BaseLayout>

<style>
  .timeline {
    position: relative;
    display: grid;
    gap: 1.5rem;
  }
  .timeline::before {
    content: '';
    position: absolute;
    top: 1.5rem;
    bottom: 1.5rem;
    left: 1.6rem;
    width: 1px;
    background: linear-gradient(to bottom, var(--color-gold), rgb(192 159 36 / 0.2));
  }
  .timeline-step {
    position: relative;
    display: grid;
    grid-template-columns: 3.2rem 1fr;
    gap: 1.25rem;
    align-items: start;
  }
  .timeline-num {
    position: relative;
    display: grid;
    place-items: center;
    width: 3.2rem;
    height: 3.2rem;
    border: 1px solid rgb(192 159 36 / 0.6);
    border-radius: 999px;
    background-color: var(--color-cream);
    font-size: 1.35rem;
  }
  @media (min-width: 768px) {
    .timeline { gap: 2rem; }
    .timeline::before { left: 2.25rem; }
    .timeline-step { grid-template-columns: 4.5rem 1fr; gap: 2rem; }
    .timeline-num { width: 4.5rem; height: 4.5rem; font-size: 1.9rem; }
  }
</style>
